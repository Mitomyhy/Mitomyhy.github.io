{
  "manifest_version": 3,
  "name": "UOY Base Companion",
  "version": "1.0.27",
  "description": "Warm the calibrated UOY Order reader on restored Base tabs, then retain it hidden for explicit Photoshop reads. No API key or cookies.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["storage", "scripting", "alarms", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*.larksuite.com/*", "https://*.feishu.cn/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "UOY Base Companion"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
