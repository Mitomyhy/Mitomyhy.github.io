      ],
      "webhookId": "9c740a41-ecc2-43d3-a62e-ae50f738574b",
      "notes": "Select a Header Auth credential with Name X-MITOM-Token. The secret is entered in n8n and the MITOM browser connection, never in this export.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body=$input.first().json.body;\nconst fail=msg=>[{json:{valid:false,httpStatus:400,response:{code:400,msg,data:null}}}];\nif(!body||typeof body!=='object'||Array.isArray(body))return fail('Send a JSON request body.');\nconst prompt=typeof body.prompt==='string'?body.prompt.trim():'';\nif(!prompt||prompt.length>5000)return fail('Prompt must contain 1–5000 characters.');\nconst aspect_ratio=body.aspect_ratio??'16:9';\nif(!['16:9','9:16'].includes(aspect_ratio))return fail('Aspect ratio must be 16:9 or 9:16.');\nif(body.imageUrl!=null&&typeof body.imageUrl!=='string')return fail('Image URL must be a string.');\nif(body.imageBase64!=null&&typeof body.imageBase64!=='string')return fail('Image data must be a Base64 data URL.');\nlet imageUrl=(body.imageUrl??'').trim(),imageBase64=(body.imageBase64??'').trim();\nif(imageUrl&&imageBase64)return fail('Choose one product image: upload or URL.');\nif(imageUrl){try{const url=new URL(imageUrl);if(url.protocol!=='https:'||url.username||url.password||imageUrl.length>4096)throw Error();}catch{return fail('Product image URL must be an HTTPS URL without login credentials.');}}\nconst request={prompt,aspect_ratio,imageUrl};\nif(imageBase64){\n  const match=imageBase64.match(/^data:(image\\/(?:png|jpeg|webp));base64,([A-Za-z0-9+/]+={0,2})$/);\n  if(!match)return fail('Upload a PNG, JPEG or WebP product image as a Base64 data URL.');\n  const encoded=match[2];\n  if(encoded.length>Math.ceil(5*1024*1024/3)*4)return fail('Product image must be at most 5 MiB.');\n  if(encoded.length%4!==0||! /^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(encoded))return fail('Invalid Base64 image data.');\n  const bytes=Buffer.from(encoded,'base64');\n  if(!bytes.length||bytes.length>5*1024*1024)return fail('Product image must be at most 5 MiB.');\n  const hex=bytes.subarray(0,12).toString('hex'),mime=match[1];\n  const valid= mime==='image/png'?hex.startsWith('89504e470d0a1a0a'):mime==='image/jpeg'?hex.startsWith('ffd8ff'):hex.startsWith('52494646')&&hex.slice(16,24)==='57454250';\n  if(!valid)return fail('Product image contents do not match the selected image type.');\n  const extension={'image/png':'png','image/jpeg':'jpg','image/webp':'webp'}[mime];\n  const stem=typeof body.imageName==='string'?body.imageName.replace(/^.*[\\\\/]/,'').replace(/\\.[^.]*$/,'').replace(/[^a-zA-Z0-9_-]/g,'-').slice(0,70):'product';\n  request.imageBase64=imageBase64;\n  request.imageName=(stem||'product')+'-'+Date.now()+'-'+Math.random().toString(36).slice(2,10)+'.'+extension;\n}\nreturn [{json:{valid:true,needsUpload:Boolean(imageBase64),request}}];"
      },
