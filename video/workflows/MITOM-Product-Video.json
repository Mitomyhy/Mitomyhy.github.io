    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input=$input.first().json,body=input.body;\nconst httpStatus=Number(input.statusCode)||0;\nconst request={...$('Validate generate').first().json.request};\ndelete request.imageBase64;\nif(!body||typeof body!=='object'||Array.isArray(body))return [{json:{valid:false,httpStatus:502,response:{code:502,msg:'Image upload request failed. Check the n8n connection and provider credential.',data:null}}}];\nif(httpStatus<200||httpStatus>=300||Number(body.code)!==200||body.success===false)return [{json:{valid:false,httpStatus:502,response:body}}];\nlet imageUrl=body.data?.downloadUrl;\ntry{const url=new URL(imageUrl);if(typeof imageUrl!=='string'||url.protocol!=='https:'||url.username||url.password)throw Error();}catch{return [{json:{valid:false,httpStatus:502,response:{code:502,msg:'The upload provider did not return a usable HTTPS image URL.',data:null}}}];}\nrequest.imageUrl=imageUrl;\nreturn [{json:{valid:true,request}}];"
